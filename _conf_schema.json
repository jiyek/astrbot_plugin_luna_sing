{
    "enabled": {
        "description": "启用唱歌功能",
        "type": "bool",
        "default": true,
        "hint": "关闭后指令和自然语言都不会发送歌曲。"
    },
    "send_mode": {
        "description": "发送方式",
        "type": "string",
        "options": [
            "file",
            "record"
        ],
        "default": "file",
        "hint": "file：发送 MP3 文件，适合 3–5 分钟完整歌曲；record：发送语音消息，QQ 对长语音限制很严，可能失败。"
    },
    "mp3_bitrate": {
        "description": "MP3 码率",
        "type": "string",
        "options": [
            "128k",
            "192k",
            "320k"
        ],
        "default": "192k",
        "hint": "码率越高文件越大；320k 转换更慢。"
    },
    "avoid_repeat": {
        "description": "避免连续重复",
        "type": "bool",
        "default": true,
        "hint": "随机点歌时尽量不选上一首；指定歌名时不受此限制。"
    },
    "cooldown_seconds": {
        "description": "点歌冷却（秒）",
        "type": "int",
        "default": 0,
        "hint": "填 0 表示不限制；大于 0 时同一会话在这个时间内只能点一次。"
    },
    "miss_reply": {
        "description": "点不到时的回复模板",
        "type": "string",
        "default": "",
        "hint": "留空使用内置的人格化台词。可用 {title} 表示用户点的歌名，{songs} 表示现有曲目列表；模板里带上 {songs} 就不会再自动追加列表。"
    },
    "list_songs_on_miss": {
        "description": "点不到时列出曲库",
        "type": "bool",
        "default": true,
        "hint": "开启后会在回复里附上现有曲目，方便用户改点。"
    }
}
